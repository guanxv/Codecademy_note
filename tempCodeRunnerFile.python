my_board = [
    [True,True,True,True],
    [False,True,False,False],
    [True,True,True,False],
    [True,False,True,False],
]

#check if unlocked
def check_lock(board):
    for row in board:
        for col in row:
            if col == False:
                return False    
    return True

def shift_row_left(board,r_num):
    board[r_num].append(board[r_num][0])
    board[r_num].pop(0)

def shift_row_right(board,r_num):
    board[r_num].insert(0,board[r_num][-1])
    board[r_num].pop(-1)

def print_board(board):
    for row in board:
        print(row)

def shift_col_up(board,col):
    temp = board[0][col]
    board[0][col] = board[1][col]
    board[1][col] = board[2][col]
    board[2][col] = board[3][col]
    board[3][col] = temp

def shift_col_down(board,col):
    temp = board[3][col]
    board[3][col] = board[2][col]
    board[2][col] = board[1][col]
    board[1][col] = board[0][col]
    board[0][col] = temp

def invert(board):
    for row in board:
        for col in row:
            #if col == True:
            #    col = False
            col = 0


